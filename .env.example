# PLACEHOLDERS ONLY. Copy to .env and set real values on the server.
# Never commit real secrets. Generate SECRET_KEY with: openssl rand -hex 32

# Postgres container
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=travel_booking

# Backend
DATABASE_URL=postgresql://travel_user:change-me@db:5432/travel_booking
SECRET_KEY=replace-with-random-string-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_MOBILE=0000000000

# Frontend / deployment (Hostinger VPS behind Traefik)
# Public domain Traefik should route to this app (details to be provided later).
APP_DOMAIN=travel.example.com
# Host port the frontend container binds on 127.0.0.1; pick a free one on the VPS.
FRONTEND_PORT=8083
# Leave empty: the frontend calls /api on its own origin and nginx proxies it to the backend.
VITE_API_URL=
